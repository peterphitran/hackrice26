# Application
LOU_ENVIRONMENT=local
LOU_LOG_LEVEL=INFO
LOU_ARTIFACT_ROOT=.lou/artifacts

# PostgreSQL
LOU_POSTGRES_PORT=5432
LOU_POSTGRES_MIGRATOR_PASSWORD=lou_migrator
LOU_POSTGRES_RUNTIME_PASSWORD=lou
LOU_POSTGRES_TEST_APP_PASSWORD=lou_test_app
LOU_MIGRATION_DATABASE_URL=postgresql+psycopg://lou_migrator:lou_migrator@localhost:5432/lou
LOU_DATABASE_URL=postgresql+psycopg://lou:lou@localhost:5432/lou
LOU_TEST_DATABASE_URL=postgresql+psycopg://lou_test_app:lou_test_app@localhost:5432/lou_test
# Used inside the isolated Docker fixture network by `lou analyze`.
LOU_FIXTURE_DATABASE_URL=postgresql://lou_migrator:lou_migrator@postgres:5432/lou
